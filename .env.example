# LOCAL uses SQLite/local images; CLOUD uses Neon/GCS images.
MODE=LOCAL
# CLOUD images use Application Default Credentials (the runtime identity on Cloud Run).
GCS_IMAGES_BUCKET=orch_app_bucket
SQL_DATABASE_TYPE=sqlite
# Relative paths resolve from the repository root; the database must exist.
SQLITE_DATABASE_PATH=database/gym_app.db
# Required in CLOUD mode. Inject from Secret Manager on Cloud Run.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
